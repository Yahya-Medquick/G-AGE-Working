# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Additional fallback keys (e.g. GEMINI_API_KEY_1, GEMINI_API_KEY_2) are supported for key rotation & rate limit handling.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# Public Base URL for custom domains, canonical URLs, and SEO sitemaps
# Override this when deploying to custom domain (e.g. PUBLIC_BASE_URL="https://gage-ai.com")
PUBLIC_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional External API Keys for extended rate limits & news
# Note: Project Atlas features built-in fallback APIs (Wikipedia, OpenAlex, Google Books, Public GitHub REST API, Reddit API, Gemini AI Synthesis) when these keys are omitted.
NEWS_API_KEY=""
YOUTUBE_API_KEY=""
GITHUB_TOKEN=""

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="863164045495-rjdd6sp0f71vnu6sug34vtoqretbvnlb.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="863164045495-rjdd6sp0f71vnu6sug34vtoqretbvnlb.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# Secret key for session signing / JWT verification
SESSION_SECRET="gage_ai_engine_secret_session_key_2026"

# Google Books API Key
GOOGLE_BOOKS_API_KEY=""

# Administrative API secret token for protected mutation endpoints
ADMIN_TOKEN=""

# PostgreSQL / Supabase connection credentials
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
DATABASE_URL=""

# Resend API Key
RESEND_API_KEY=re_your_key_here

# WhatsApp Support Desk Number (E.164 without plus, e.g. 923264397102)
VITE_WHATSAPP_SUPPORT_NUMBER=923264397102

# Firebase Phone Authentication Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OpenRouter API Key for ultra-resilient multi-provider AI fallback
OPENROUTER_API_KEY=""
